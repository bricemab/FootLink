# === Base de données ===
DATABASE_URL="mysql://user:password@localhost:3306/footlink"

# === Serveur ===
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# === Gate de version app ===
API_MIN_VERSION=1.0.0
API_LATEST_VERSION=1.0.0

# === JWT (auth) ===
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# === Email (Gmail SMTP + app password) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=FootLink

# === Stockage S3-compatible (R2 / B2) ===
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=footlink-media

# === Google Sign-In (audiences acceptées, séparées par des virgules) ===
GOOGLE_CLIENT_IDS=
