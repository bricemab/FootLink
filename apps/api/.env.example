# === Base de données ===
DATABASE_URL="mysql://user:password@localhost:3306/footlink"

# === Serveur ===
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# === Gate de version app ===
API_MIN_VERSION=1.0.0
API_LATEST_VERSION=1.0.0

# === JWT (auth) ===
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# === Email (Gmail SMTP + app password) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=FootLink

# === Stockage S3-compatible (R2 / B2) ===
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=footlink-media

# === Google Sign-In (audiences acceptées, séparées par des virgules) ===
GOOGLE_CLIENT_IDS=

# === Mapbox (recherche du terrain d'un club) ===
# Jeton PUBLIC (pk.…), créé sur https://account.mapbox.com. Il est conçu pour
# être exposé côté client, mais on le garde ici : le faire tourner ne demande
# alors aucune mise à jour de l'app sur les stores.
# Sans lui, l'API répond 503 sur /geo/places et l'app bascule sur la saisie
# manuelle de la localité — l'inscription reste possible.
# Sert UNIQUEMENT à chercher : le canton, la commune et la photo aérienne
# viennent de swisstopo, qui est gratuit et n'a pas besoin de jeton.
MAPBOX_TOKEN=

# === Liens d'email ===
# Base des liens envoyés par email. Ils pointent sur une page servie par CETTE
# API (/l/<action>), qui ouvre l'app si elle est installée et redirige vers le
# store sinon.
# EN DEV : mettre l'IP de la machine, sinon le lien reçu sur le téléphone
# tombe sur le localhost DU TÉLÉPHONE et ne mène nulle part.
#   PUBLIC_BASE_URL=http://192.168.1.20:3000
PUBLIC_BASE_URL=https://footlink.ch
# L'identifiant App Store n'existe qu'une fois l'app publiée ; d'ici là, le
# défaut renvoie sur la recherche du store.
# IOS_STORE_URL=https://apps.apple.com/ch/app/footlink/id000000000
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=ch.footlink.app
