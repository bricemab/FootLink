{
  "name": "footlink",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "api:dev": "pnpm --filter @footlink/api start:dev",
    "db:generate": "pnpm --filter @footlink/api db:generate",
    "db:migrate": "pnpm --filter @footlink/api db:migrate",
    "db:seed": "pnpm --filter @footlink/api db:seed",
    "db:studio": "pnpm --filter @footlink/api db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
